{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "crons": [
    {
      "path": "/api/cron/backup-sweep",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/purge-expired",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/jobs",
      "schedule": "0 4 * * *"
    }
  ]
}
