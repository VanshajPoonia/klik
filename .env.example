# Neon Postgres - pooled connection string from your Neon project
DATABASE_URL=

# Auth.js - generate with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend - magic-link sign-in emails and the signup welcome email, both
# through the same account and the same verified domain.
AUTH_RESEND_KEY=
# Must be a domain verified in your Resend account. Not the marketing domain,
# and not guessed: Resend rejects anything unverified, which surfaces as a send
# that fails rather than as a setting that is wrong.
#
# This matches APP_URL on purpose, so the sender and the links inside the email
# are the same domain. The trade is that a subdomain would have quarantined
# sending reputation, keeping a run of spam complaints away from the domain that
# also serves the app. mail.klik.kreativvantage.com is verified and remains the
# safer option if that ever becomes a problem.
AUTH_EMAIL_FROM="Klik <no-reply@klik.kreativvantage.com>"

# GRW-1. The postal address printed in every recap email's footer, which US law
# (CAN-SPAM) requires. Leave blank and guests are simply not offered the recap.
# A real address where Klik receives mail, on one line, e.g.
# "Kreativ Vantage, 123 Example St, Suite 4, Austin, TX 78701, USA"
COMPANY_POSTAL_ADDRESS=

# Stripe - test keys from https://dashboard.stripe.com/test/apikeys
# Optional: without STRIPE_SECRET_KEY the checkout route answers 503 and the
# rest of Klik is unaffected. Never commit a real key; this file is tracked.
STRIPE_SECRET_KEY=
# Read in the browser, so the NEXT_PUBLIC_ prefix is required. Next inlines only
# prefixed variables into the client bundle; without it the key is undefined
# there and the payment form fails to initialise with no build error.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# One Price ID per plan in lib/plans.ts. Dashboard > Product catalogue > the
# product > Pricing section, or `stripe prices list`. Test and live mode have
# different IDs for the same product, so these change with the keys above.
STRIPE_PRICE_EVENT=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_VENUE_MONTHLY=
# Signing secret for the Stripe webhook. Locally this comes from
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe`, and it is a
# different value from the one the Dashboard shows for the deployed endpoint.
STRIPE_WEBHOOK_SECRET=

# Cloudflare R2 - S3-compatible API token scoped to the bucket, from the R2 dashboard
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional. Leave blank to use R2's EU-jurisdiction host, which is where the
# current bucket lives. Set it to https://<account>.r2.cloudflarestorage.com
# when moving to an unpinned bucket (ROADMAP OPS-4), together with the new
# R2_BUCKET_NAME above.
R2_ENDPOINT=
# Second bucket the nightly sweep copies into, protected by Bucket Lock so
# neither a bug nor a stolen token can delete from it. Leave blank to run
# without a backup; the sweep then reports that it is unconfigured.
R2_BACKUP_BUCKET=
# Where runtime errors are emailed, throttled to one per event name per 15
# minutes. Leave blank and nothing is sent; the structured log is then the only
# record. A stopgap until Sentry (ROADMAP F-9).
ALERT_EMAIL=
# Keep the bucket private. Media is delivered through authenticated, short-lived URLs.

# Public app URL, used to build QR codes and share links (no trailing slash)
APP_URL=https://klik.kreativvantage.com

# Protects the /api/cron/purge-expired route from being called by anyone but Vercel Cron
CRON_SECRET=

# Optional. A heartbeat monitor URL the purge cron pings after a successful run.
# Without it, a cron that silently stops firing produces no logs, no errors and
# no alert, and looks exactly like a quiet night.
CRON_HEARTBEAT_URL=
